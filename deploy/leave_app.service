[Unit]
Description=Leave Management Flask app (gunicorn)
After=network.target

[Service]
# Replace YOUR_USERNAME with the username on the target server (e.g. ubuntu, debian, pi, atreya)
User=YOUR_USERNAME
Group=YOUR_USERNAME

# Full path to where the repository is located on the target server
WorkingDirectory=/home/YOUR_USERNAME/Leave_TKE_v1

# Load environment variables (such as SECRET_KEY)
EnvironmentFile=/home/YOUR_USERNAME/Leave_TKE_v1/.env

# Path to gunicorn inside the server's standard virtual environment (venv)
ExecStart=/home/YOUR_USERNAME/Leave_TKE_v1/venv/bin/gunicorn app:app

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
